<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Opening soon</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body class="password-page">
  <main class="password-main">
    {{ content_for_layout }}
    <a href="{{ routes.root_url }}" class="logo">KICK<span>STEP</span></a>
    <p class="kicker">Members only</p>
    <h1>THE NEXT DROP<br>IS <span class="outline-text">CLOSE.</span></h1>
    <p>Enter the store password to step inside.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default: '' }}
      <div class="newsletter-form">
        <input type="password" name="password" placeholder="Store password" required>
        <button type="submit" class="btn btn-primary">Enter</button>
      </div>
    {% endform %}
  </main>
</body>
</html>
