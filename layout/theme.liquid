<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

  <script>
    window.__SHOP_CUSTOMER__ = {% if customer %}{{ customer | json }}{% else %}null{% endif %};
    window.__SHOP_DOMAIN__ = {{ shop.permanent_domain | json }};
  </script>
</head>
<body class="template-{{ request.page_type }}">

  <div class="grain" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursorDot"></div>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- AI Concierge launcher — mounts the chat widget (Phase 3) -->
  <button class="chat-launcher" id="chatLauncher" aria-label="Open chat">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
  </button>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {% comment %} Agent widget script — swap in the real hosted URL once the backend is deployed (Phase 3). {% endcomment %}
  {% comment %} <script src="https://YOUR-AGENT-SERVER.example.com/widget.js" async></script> {% endcomment %}
</body>
</html>
