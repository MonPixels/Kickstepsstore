<section class="section search-page">
  <header class="section-head">
    <p class="kicker">Search</p>
    <h2>{% if search.performed %}Results for “{{ search.terms }}”{% else %}Search Kickstep{% endif %}</h2>
  </header>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products...">
    <button type="submit" class="btn btn-primary">{{ 'general.search.search' | t }}</button>
  </form>

  {% if search.performed %}
    <div class="product-grid">
      {% for item in search.results %}
        <article class="product-card reveal in-view">
          <a href="{{ item.url }}" class="product-media">
            {% if item.featured_image %}<img class="img-a" src="{{ item.featured_image | image_url: width: 900 }}" alt="{{ item.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
          </a>
          <div class="product-info"><h3>{{ item.title }}</h3></div>
        </article>
      {% else %}
        <p>No results found.</p>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{ "name": "Search page", "settings": [] }
{% endschema %}
