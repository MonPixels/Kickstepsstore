<section class="statement">
  <div class="statement-media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="" width="1800" height="1200" loading="lazy">
    {% else %}
      <img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?q=80&w=1800&auto=format&fit=crop" alt="" width="1800" height="1200" loading="lazy">
    {% endif %}
  </div>
  <div class="statement-content">
    <p class="kicker reveal">{{ section.settings.kicker }}</p>
    <h2 class="reveal">{{ section.settings.heading }}</h2>
    <p class="reveal">{{ section.settings.body }}</p>
    <a href="{{ section.settings.link }}" class="btn btn-ghost reveal">{{ section.settings.link_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Statement",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The Craft" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Every pair starts with a problem worth solving." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Our design studio spends 400+ hours per silhouette chasing grip, weight, and fit. No filler drops. No shortcuts." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the Story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Statement" }]
}
{% endschema %}
