<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="logo">KICK<span>STEP</span></span>
      <p>{{ section.settings.tagline }}</p>
    </div>
    {% for block in section.blocks %}
      <div class="footer-col">
        <h4>{{ block.settings.heading }}</h4>
        {% assign links = block.settings.links | newline_to_br | strip_newlines | split: '<br />' %}
        {% for link in links %}
          <a href="#">{{ link | strip }}</a>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
  <div class="footer-bottom">
    <p>© {{ 'now' | date: "%Y" }} Kickstep. {{ 'sections.footer.rights' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Engineered for the street. Designed to last." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "textarea", "id": "links", "label": "Links (one per line)", "default": "New Arrivals\nBestsellers\nSale" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop", "links": "New Arrivals\nBestsellers\nSale" } },
      { "type": "column", "settings": { "heading": "Support", "links": "Track Order\nReturns\nSize Guide\nAsk the AI Concierge" } },
      { "type": "column", "settings": { "heading": "Company", "links": "Our Story\nCareers\nContact" } }
    ]
  }
}
{% endschema %}
