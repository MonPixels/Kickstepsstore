<section class="section product-detail">
  <div class="product-detail-grid">
    <div class="product-gallery">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" class="product-gallery-main" width="1200" height="1500" loading="eager">
      {% endif %}
      {% if product.images.size > 1 %}
        <div class="product-gallery-thumbs">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="200" height="200" loading="lazy">
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info-panel">
      <h1>{{ product.title }}</h1>
      <p class="price">{{ product.price | money }}</p>
      <div class="product-description">{{ product.description }}</div>

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <div class="variant-picker">
            <label for="variant-select">Size</label>
            <select name="id" id="variant-select">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} — Sold Out{% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}

        <button type="submit" class="btn btn-primary btn-full" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
        </button>
      {% endform %}

      <div class="product-meta-block">
        <p>Free exchanges within 30 days.</p>
        <p>Questions? Ask the AI Concierge — bottom right.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Product page", "settings": [] }
{% endschema %}
