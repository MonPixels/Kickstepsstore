<section class="collections section" id="collections">
  <header class="section-head">
    <p class="kicker reveal">{{ section.settings.kicker }}</p>
    <h2 class="reveal">{{ section.settings.heading }}</h2>
  </header>
  <div class="collection-grid">
    {% assign fallback_images = "https://images.unsplash.com/photo-1595341888016-a392ef81b7de?q=80&w=1200&auto=format&fit=crop|https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?q=80&w=1200&auto=format&fit=crop|https://images.unsplash.com/photo-1552346154-21d32810aba3?q=80&w=1200&auto=format&fit=crop" | split: "|" %}
    {% assign fallback_handles = "street|trail|court" | split: "|" %}
    {% for block in section.blocks %}
      {% assign picked = collections[block.settings.collection] %}
      {% assign coll = picked | default: collections[fallback_handles[forloop.index0]] %}
      <a href="{{ coll.url | default: '#' }}" class="collection-card reveal">
        {% if coll.image %}
          <img src="{{ coll.image | image_url: width: 1200 }}" alt="{{ coll.title | escape }}" width="1200" height="800" loading="lazy">
        {% elsif block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.label }}" width="1200" height="800" loading="lazy">
        {% else %}
          <img src="{{ fallback_images[forloop.index0] | default: fallback_images[0] }}" alt="{{ block.settings.label }}" width="1200" height="800" loading="lazy">
        {% endif %}
        <span class="collection-label">{{ block.settings.label | default: coll.title }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop by Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your terrain." }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "collection_card", "settings": { "label": "Street" } },
      { "type": "collection_card", "settings": { "label": "Trail" } },
      { "type": "collection_card", "settings": { "label": "Court" } }
    ]
  }
}
{% endschema %}
