<section class="products section" id="new">
  <header class="section-head">
    <p class="kicker reveal">{{ section.settings.kicker }}</p>
    <h2 class="reveal">{{ section.settings.heading }}</h2>
  </header>

  <div class="product-grid">
    {% assign coll = collections[section.settings.collection] %}
    {% if coll and coll.products.size > 0 %}
      {% for product in coll.products limit: section.settings.products_to_show %}
        {% assign img_a = product.featured_image %}
        {% assign img_b = product.images[1] | default: img_a %}
        <article class="product-card reveal">
          <a href="{{ product.url }}" class="product-media">
            {% if img_a %}<img class="img-a" src="{{ img_a | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
            {% if img_b %}<img class="img-b" src="{{ img_b | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
            {% if product.available == false %}
              <span class="badge badge-sold">{{ 'products.product.sold_out' | t }}</span>
            {% elsif product.selected_or_first_available_variant.inventory_quantity <= 3 and product.selected_or_first_available_variant.inventory_quantity > 0 %}
              <span class="badge badge-low">{{ 'products.product.low_stock' | t }}</span>
            {% elsif product.tags contains 'new' %}
              <span class="badge badge-new">New</span>
            {% endif %}
            <button class="quick-add" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}{{ 'products.product.quick_add' | t }}{% else %}{{ 'products.product.notify_me' | t }}{% endif %}
            </button>
          </a>
          <div class="product-info">
            <div>
              <h3>{{ product.title }}</h3>
              <p class="product-meta">{{ product.type }}</p>
            </div>
            <p class="price">{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% comment %} Placeholder cards shown until real products are added / collection is selected {% endcomment %}
      {% for i in (1..4) %}
        <article class="product-card reveal">
          <div class="product-media">
            <img class="img-a" src="{{ 'product-placeholder.svg' | asset_url }}" alt="Sample product" width="600" height="750" loading="lazy">
          </div>
          <div class="product-info">
            <div><h3>Sample Sneaker</h3><p class="product-meta">Select a collection ↑</p></div>
            <p class="price">$—</p>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New Arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh off the last." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
