<section class="products section" id="new">
  <header class="section-head">
    <p class="kicker reveal">{{ section.settings.kicker }}</p>
    <h2 class="reveal">{{ section.settings.heading }}</h2>
  </header>

  <div class="product-grid">
    {% assign coll = collections[section.settings.collection] %}
    {% unless coll and coll.products.size > 0 %}
      {% assign coll = collections['all'] %}
    {% endunless %}
    {% unless coll and coll.products.size > 0 %}
      {% assign coll = collections.all %}
    {% endunless %}
    {% if coll and coll.products.size > 0 %}
      {% for product in coll.products limit: section.settings.products_to_show %}
        {% assign img_a = product.featured_image %}
        {% assign img_b = product.images[1] | default: img_a %}
        <article class="product-card reveal">
          <a href="{{ product.url }}" class="product-media">
            {% if img_a %}<img class="img-a" src="{{ img_a | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
            {% if img_b %}<img class="img-b" src="{{ img_b | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1125" loading="lazy">{% endif %}
            {% if product.available == false %}
              <span class="badge badge-sold">{{ 'products.product.sold_out' | t }}</span>
            {% elsif product.selected_or_first_available_variant.inventory_quantity <= 3 and product.selected_or_first_available_variant.inventory_quantity > 0 %}
              <span class="badge badge-low">{{ 'products.product.low_stock' | t }}</span>
            {% elsif product.tags contains 'new' %}
              <span class="badge badge-new">New</span>
            {% endif %}
          </a>
          <a href="{{ product.url }}" class="quick-add">
            {% if product.available %}{{ 'products.product.quick_add' | t }}{% else %}{{ 'products.product.notify_me' | t }}{% endif %}
          </a>
          <div class="product-info">
            <div>
              <h3>{{ product.title }}</h3>
              <p class="product-meta">{{ product.type }}</p>
            </div>
            <p class="price">{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% comment %} Showcase cards shown until real Shopify products are connected. Real photos, real copy — no grey boxes. {% endcomment %}
      {% assign showcase_names = "Aero Field Runner|Nightshade High|Concrete 88|Glacier Trail" | split: "|" %}
      {% assign showcase_types = "Cloudfoam · Low-top|Reflective · High-top|All-terrain · Mid-top|Weatherproof · Trail" | split: "|" %}
      {% assign showcase_prices = "185|220|210|240" | split: "|" %}
      {% assign showcase_badges = "New|Low Stock|Bestseller|Sold Out" | split: "|" %}
      {% assign showcase_images = "https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?q=80&w=900&auto=format&fit=crop|https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=900&auto=format&fit=crop|https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?q=80&w=900&auto=format&fit=crop|https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=900&auto=format&fit=crop" | split: "|" %}
      {% assign showcase_handles = "aero-field-runner|nightshade-high|concrete-88|glacier-trail" | split: "|" %}
      {% for i in (0..3) %}
        <article class="product-card reveal">
          <a href="{{ routes.root_url }}products/{{ showcase_handles[i] }}" class="product-media">
            <img class="img-a" src="{{ showcase_images[i] }}" alt="{{ showcase_names[i] }}" width="900" height="1125" loading="lazy">
            {% assign badge = showcase_badges[i] %}
            {% if badge == "Sold Out" %}
              <span class="badge badge-sold">{{ badge }}</span>
            {% elsif badge == "Low Stock" %}
              <span class="badge badge-low">{{ badge }}</span>
            {% else %}
              <span class="badge badge-new">{{ badge }}</span>
            {% endif %}
          </a>
          <a href="{{ routes.root_url }}products/{{ showcase_handles[i] }}" class="quick-add">
            {% if badge == "Sold Out" %}{{ 'products.product.notify_me' | t }}{% else %}{{ 'products.product.quick_add' | t }}{% endif %}
          </a>
          <div class="product-info">
            <div><h3>{{ showcase_names[i] }}</h3><p class="product-meta">{{ showcase_types[i] }}</p></div>
            <p class="price">${{ showcase_prices[i] }}</p>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New Arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh off the last." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
